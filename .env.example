# URL del stream MJPEG del ESP32-CAM
ESP32_STREAM_URL=http://192.168.68.108/mjpeg

# GID del grupo "audio" del host (Raspberry Pi OS/Debian suele ser 29)
# Verifícalo con: getent group audio
AUDIO_GID=29

# UID del usuario dueño de la sesión PipeWire (normalmente 1000)
PULSE_UID=1000

# Cookie de PulseAudio/PipeWire del usuario
PULSE_COOKIE_PATH=/home/ivan/.config/pulse/cookie

# Solo reproducción: no usar el micrófono de la bocina Bluetooth.
# Ponlo en true y configura AUDIO_INPUT_DEVICE si quieres wake word/comandos.
MIC_ENABLED=false

# Dispositivo de entrada opcional (por nombre o índice de sounddevice)
# AUDIO_INPUT_DEVICE=default

# Motor TTS: piper (neuronal, recomendado), espeak o auto
TTS_ENGINE=piper

# Voz Piper. Para cambiarla, edita este valor y reconstruye la imagen:
#   docker compose build doorbell-voice
PIPER_VOICE=es_MX-claude-high

# Ajustes de Piper
# length_scale: menor = más rápido, mayor = más pausado
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0

# Voz de respaldo espeak: roa/es-419 (Latinoamérica) o roa/es (España)
ESPEAK_VOICE=roa/es-419
